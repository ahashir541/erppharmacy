{
  "name": "@medflow/server",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "MedFlow Local: the pharmacy's own server on the shop PC. Data on disk, counters over the shop network, nightly backups.",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs --server-only --no-node && node release/MedFlow/medflow-server.mjs",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/medflow.e2e.mjs",
    "journey": "node e2e/journey.e2e.mjs --keys C:/MedFlowHQ/hq-keys"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@medflow/core": "workspace:*"
  },
  "devDependencies": {
    "@medflow/config": "workspace:*",
    "@types/node": "22.18.6",
    "esbuild": "0.21.5",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  }
}
