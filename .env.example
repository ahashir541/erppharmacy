# Copy to .env (never commit .env). Placeholders only.

# Supabase project (Settings > API). The anon key is public by design;
# RLS protects the data. The service role key bypasses RLS: only Edge
# Functions and CI may hold it — never put it in an app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Where owners land after the invitation email (the web app, Phase 2+).
MEDFLOW_WEB_URL=https://app.example.com
